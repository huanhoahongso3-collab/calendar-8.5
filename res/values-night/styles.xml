<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Base.Widget.AppCompat.Button.Custom" parent="@style/Base.Widget.AppCompat.Button">
        <item name="buttonCornerRadius">22.0dip</item>
    </style>
    <style name="CalendarTheme.Dialog.Alert" parent="@android:style/Theme.DeviceDefault.Dialog.Alert">
        <item name="android:colorControlNormal">@color/color_common_component</item>
        <item name="android:colorControlActivated">@color/color_control_activated</item>
        <item name="android:colorPrimary">@color/primary</item>
        <item name="android:colorPrimaryDark">@color/primary_dark</item>
        <item name="android:windowLayoutInDisplayCutoutMode">never</item>
