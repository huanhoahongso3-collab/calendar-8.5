    </style>
    <style name="Theme.SEP10.NoActionBar.Location.Base" parent="@style/Theme.SEP10.NoActionBar.Location">
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
    </style>
    <style name="Theme.SEP10.NoActionBar.Base.Night" parent="@style/Theme.SEP10.NoActionBar.Night">
