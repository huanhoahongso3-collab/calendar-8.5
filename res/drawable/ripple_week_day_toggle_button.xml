<?xml version="1.0" encoding="utf-8"?>
<selector
  xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="false" android:state_checked="true">
        <layer-list>
            <item>
                <shape>
                    <padding android:left="1.0dip" android:top="1.0dip" android:right="1.0dip" android:bottom="1.0dip" />
                </shape>
            </item>
            <item android:gravity="center">
                <shape android:shape="oval">
                    <stroke android:width="2.0px" android:color="@color/repeat_sub_option_selected_color" />
                </shape>
            </item>
        </layer-list>
    </item>
    <item android:state_focused="true" android:state_checked="true">
        <layer-list>
            <item>
                <shape>
                    <padding android:left="1.0dip" android:top="1.0dip" android:right="1.0dip" android:bottom="1.0dip" />
                </shape>
            </item>
            <item android:gravity="center">
                <shape android:shape="oval">
                    <solid android:color="?android:colorControlHighlight" />
                    <stroke android:width="2.0px" android:color="@color/repeat_sub_option_selected_color" />
                </shape>
            </item>
        </layer-list>
    </item>
    <item android:state_focused="true" android:state_checked="false">
        <layer-list>
            <item>
                <shape>
                    <padding android:left="1.0dip" android:top="1.0dip" android:right="1.0dip" android:bottom="1.0dip" />
                </shape>
            </item>
            <item>
                <shape android:shape="oval">
                    <solid android:color="?android:colorControlHighlight" />
                </shape>
            </item>
        </layer-list>
    </item>
</selector>
