<?xml version="1.0" encoding="utf-8"?>
<FrameLayout android:id="@id/widget_container" android:layout_width="fill_parent" android:layout_height="fill_parent"
  xmlns:android="http://schemas.android.com/apk/res/android">
    <FrameLayout android:layout_gravity="center" android:layout_width="@dimen/widget_today_cover_2x2_min_width" android:layout_height="@dimen/widget_today_cover_2x2_min_height">
