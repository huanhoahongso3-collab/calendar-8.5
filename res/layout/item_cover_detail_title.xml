<?xml version="1.0" encoding="utf-8"?>
<LinearLayout android:orientation="horizontal" android:layout_width="fill_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/widget_detail_cover_title_item_margin_top" android:layout_marginBottom="@dimen/widget_detail_cover_title_item_margin_bottom"
  xmlns:android="http://schemas.android.com/apk/res/android">
    <LinearLayout android:orientation="horizontal" android:layout_width="0.0dip" android:layout_height="wrap_content" android:layout_weight="1.0" android:paddingStart="@dimen/cover_detail_container_padding_start">
        <ImageView android:layout_gravity="end|top" android:id="@id/event_color_image" android:layout_width="@dimen/event_list_color_bar_width" android:layout_height="@dimen/event_list_color_bar_height" android:layout_marginTop="@dimen/event_list_color_bar_margin_top" android:src="@drawable/event_list_color_bar_background" android:layout_marginStart="@dimen/cover_detail_event_color_image_margin_start" />
