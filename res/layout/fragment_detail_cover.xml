<?xml version="1.0" encoding="utf-8"?>
<LinearLayout android:orientation="vertical" android:layout_width="fill_parent" android:layout_height="fill_parent"
  xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto">
    <FrameLayout android:layout_width="fill_parent" android:layout_height="@dimen/list_widget_cover_action_bar_height">
        <ImageView android:layout_gravity="start|center" android:id="@id/back_button" android:background="@drawable/common_actionbar_button_ripple" android:layout_width="@dimen/widget_cover_back_icon_detail_container_size" android:layout_height="@dimen/widget_cover_back_icon_detail_container_size" android:src="@drawable/actionbar_back_icon_cover" android:scaleType="center" android:contentDescription="@string/navigate_up" android:layout_marginStart="@dimen/widget_detail_cover_back_button_margin_start" app:tint="@color/widget_detail_cover_back_icon_tint_color" />
        <ImageView android:layout_gravity="end|center" android:id="@id/delete_icon_button" android:background="@drawable/common_actionbar_button_ripple" android:focusable="true" android:visibility="gone" android:layout_width="@dimen/widget_cover_back_icon_detail_container_size" android:layout_height="@dimen/widget_cover_back_icon_detail_container_size" android:src="@drawable/action_bar_delete_button" android:scaleType="center" android:tint="@color/widget_detail_cover_text" android:contentDescription="@string/delete" android:layout_marginEnd="@dimen/widget_detail_cover_delete_icon_margin_end" />
    </FrameLayout>
    <ScrollView android:scrollbarThumbVertical="@drawable/scrollbar_detail_cover" android:scrollbarStyle="outsideOverlay" android:layout_width="fill_parent" android:layout_height="0.0dip" android:fillViewport="true" android:layout_weight="1.0" android:layout_marginEnd="@dimen/widget_cover_scroll_view_bottom_margin_end">
        <LinearLayout android:orientation="vertical" android:layout_width="fill_parent" android:layout_height="fill_parent" android:layout_marginEnd="@dimen/widget_cover_detail_view_item__margin_end">
            <include layout="@layout/item_cover_detail_title" />
            <include layout="@layout/item_cover_detail_date_time" />
            <include layout="@layout/item_cover_detail_location" />
            <include layout="@layout/item_cover_detail_account" />
            <include layout="@layout/item_cover_detail_reminder" />
            <include layout="@layout/item_cover_detail_priority" />
            <include layout="@layout/item_cover_detail_repeat" />
            <include layout="@layout/item_cover_detail_note" />
            <include layout="@layout/item_cover_detail_conference" />
            <include layout="@layout/item_cover_detail_invite" />
            <include layout="@layout/item_cover_detail_privacy" />
            <include layout="@layout/item_cover_detail_status" />
            <include layout="@layout/item_cover_detail_availability" />
            <include layout="@layout/item_cover_detail_timezone" />
            <include layout="@layout/item_cover_detail_empty_layout" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>
