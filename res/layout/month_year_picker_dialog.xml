        </FrameLayout>
    </FrameLayout>
    <FrameLayout android:id="@id/pager_container" android:layout_width="fill_parent" android:layout_height="fill_parent">
        <com.samsung.android.libcalendar.datetimepicker.monthyearpicker.MonthPickerPager android:id="@id/month_picker_pager" android:layout_width="fill_parent" android:layout_height="fill_parent" />
